# 复制成 .env.deploy 后按需改。这个文件不进版本库。

# 服务监听。走 nginx 反代时保持 127.0.0.1，别暴露到公网
HOST=127.0.0.1
PORT=27981

# 对外访问地址，订阅链接按它拼。填错的话客户端拉不到订阅。
# 只在数据库里还没填过的时候生效；之后改「设置 → 站点」即可，不用重新部署。
MSUBGA_BASE_URL=https://MSubGA.20020527.xyz:23333

# 首次部署时的管理员密码。设置过之后这行就不再生效。
# 留空的话第一次打开页面会让你在界面上设。
MSUBGA_PASSWORD=

# 数据目录（SQLite + mihomo 内核）。不填默认是仓库下的 data/
# MSUBGA_DATA_DIR=/var/lib/msubga

# 手动指定 mihomo 可执行文件；不填就在设置页点「自动下载」
# MIHOMO_PATH=/usr/local/bin/mihomo

# 部署分支
BRANCH=main
