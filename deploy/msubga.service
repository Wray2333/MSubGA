# 开机自启与崩溃自动重启。
#
# 下面三处 /path/to/MSubGA 要换成你的实际路径，一条命令搞定：
#
#   sed "s#/path/to/MSubGA#$(pwd)#g" deploy/msubga.service | sudo tee /etc/systemd/system/msubga.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now msubga
#
# 用了 systemd 之后就别再用 deploy.sh 启动了，改成：
#   SKIP_START=1 ./deploy.sh && sudo systemctl restart msubga

[Unit]
Description=MSubGA - 节点管理与订阅生成
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/path/to/MSubGA
# 与 deploy.sh 共用同一份配置
EnvironmentFile=-/path/to/MSubGA/.env.deploy
Environment=NODE_ENV=production
ExecStart=/usr/bin/env node packages/server/dist/index.js
Restart=on-failure
RestartSec=3

# 数据库和内核都写在 data/ 下，除此之外不需要写权限
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

StandardOutput=append:/path/to/MSubGA/msubga.log
StandardError=append:/path/to/MSubGA/msubga.log

[Install]
WantedBy=multi-user.target
