{
  "name": "@msubga/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MSubGA 服务端：API、订阅出口、mihomo 内核集成、静态前端托管",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.8",
    "@msubga/core": "*",
    "adm-zip": "^0.5.16",
    "drizzle-orm": "^0.39.1",
    "hono": "^4.6.20",
    "nanoid": "^5.0.9",
    "yaml": "^2.7.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^22.13.1",
    "drizzle-kit": "^0.30.4",
    "tsx": "^4.19.2"
  }
}
