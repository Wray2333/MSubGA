# 监听地址与端口
HOST=0.0.0.0
PORT=27981

# 首次启动时用来设置管理员密码。密码一旦设置过，这个变量就不再生效，
# 之后改密码走设置页。留空则第一次打开页面时在界面上设置。
MSUBGA_PASSWORD=

# 数据目录：SQLite 数据库、mihomo 内核和它的运行时配置都放这里。
# 不填则用仓库根目录下的 data/
# MSUBGA_DATA_DIR=/data

# 对外访问地址，订阅链接按它拼。跑在反代后面时必须填，
# 否则拼出来的是 http://127.0.0.1:27981 这种客户端够不着的地址。
# 只在数据库里还没填过时生效，之后改「设置 → 站点」即可。
# MSUBGA_BASE_URL=https://MSubGA.20020527.xyz:23333

# 手动指定 mihomo 可执行文件。不填则先找 data/mihomo/bin/，
# 再找不到就在设置页点「自动下载」从 GitHub Releases 拉。
# MIHOMO_PATH=/usr/local/bin/mihomo
